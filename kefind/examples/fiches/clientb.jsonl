{"fiche_id": "KB0040001", "client": "clientb", "title": "Outlook ne démarre plus", "source": "KB0040001.md", "text": "## Symptôme\nOutlook reste bloqué au démarrage, erreur 0x80070005.\n\n## Résolution\n1. Fermez Outlook.\n2. Réparez le profil Outlook depuis le Panneau de configuration > Mail.\n3. Relancez Outlook.\n", "text_sha256": "d1f6b823bba2dd518da0281fd49316101254a568ba938bc250957f2e7411dba3", "status": "citable", "confidence": "low", "reasons": ["single method: the LLM pass did not run"], "sections": [{"title": "Symptôme", "role": "symptom", "start": 12, "end": 67}, {"title": "Résolution", "role": "resolution", "start": 81, "end": 193}], "steps": [{"n": 1, "start": 84, "end": 99, "text": "Fermez Outlook.", "kind": "action", "role": "resolution", "level": 0, "condition": null, "after_failure": false, "on_failure": null, "goto": null, "instruction": null, "entities": ["app:outlook"], "refers_to": [], "sources": ["rules"]}, {"n": 2, "start": 103, "end": 171, "text": "Réparez le profil Outlook depuis le Panneau de configuration > Mail.", "kind": "action", "role": "resolution", "level": 0, "condition": null, "after_failure": false, "on_failure": null, "goto": null, "instruction": null, "entities": ["app:outlook", "menu:panneau de configuration > mail"], "refers_to": [], "sources": ["rules"]}, {"n": 3, "start": 175, "end": 192, "text": "Relancez Outlook.", "kind": "action", "role": "resolution", "level": 0, "condition": null, "after_failure": false, "on_failure": null, "goto": null, "instruction": null, "entities": ["app:outlook"], "refers_to": [], "sources": ["rules"]}], "entities": [{"canonical": "app:outlook", "kind": "app", "count": 5}, {"canonical": "err:0x80070005", "kind": "error", "count": 1}, {"canonical": "menu:panneau de configuration > mail", "kind": "menu", "count": 1}], "references": [], "methods": {"rules_steps": 3, "llm": null, "agreement": null}, "checks": {"steps_verified": 3, "steps_total": 3, "resolution_steps": 3, "failure_links": 0, "llm_quot