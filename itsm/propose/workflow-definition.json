{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "clientCode": {
      "type": "string"
    },
    "storageAccountName": {
      "type": "string"
    },
    "tableName": {
      "type": "string"
    },
    "aoaiEndpoint": {
      "type": "string"
    },
    "aoaiDeployment": {
      "type": "string"
    },
    "aoaiApiVersion": {
      "type": "string"
    },
    "allowedGroups": {
      "type": "array"
    },
    "allowedGroupNames": {
      "type": "array"
    }
  },
  "triggers": {
    "Recurrence": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Minute",
        "interval": 5
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Get_rows": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "@{concat('https://', parameters('storageAccountName'), '.table.core.windows.net/', parameters('tableName'), '()')}",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://storage.azure.com"
        },
        "queries": {
          "$filter": "@{concat('PartitionKey eq ''', parameters('clientCode'), '''')}"
        },
        "headers": {
          "x-ms-version": "2020-12-06",
          "Accept": "application/json;odata=nometadata"
        }
      },
      "runAfter": {}
    },
    "Filter_unproposed": {
      "type": "Query",
      "runAfter": {
        "Get_rows": [
          "Succeeded"
        ]
      },
      "inputs": {
        "from": "@body('Get_rows')?['value']",
        "where": "@empty(item()?['proposalStatus'])"
      }
    },
    "Get_subscribed_skus": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "https://graph.microsoft.com/v1.0/subscribedSkus",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://graph.microsoft.com"
        },
        "queries": {
          "$select": "skuPartNumber,prepaidUnits,consumedUnits"
        }
      },
      "runAfter": {
        "Filter_unproposed": [
          "Succeeded"
        ]
      }
    },
    "For_each_ticket": {
      "type": "Foreach",
      "foreach": "@body('Filter_unproposed')",
      "runAfter": {
        "Get_subscribed_skus": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Get_subject_user": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', encodeUriComponent(coalesce(items('For_each_ticket')?['subjectEmail'], 'unknown')))}",
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://graph.microsoft.com"
            },
            "queries": {
              "$select": "id,displayName,userPrincipalName,accountEnabled"
            }
          },
          "runAfter": {}
        },
        "If_subject_found": {
          "type": "If",
          "runAfter": {
            "Get_subject_user": [
              "Succeeded",
              "Failed"
            ]
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Get_subject_user')?['statusCode']",
                  200
                ]
              }
            ]
          },
          "actions": {
            "Get_subject_memberOf": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', body('Get_subject_user')?['id'], '/memberOf')}",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                },
                "queries": {
                  "$select": "id,displayName"
                }
              },
              "runAfter": {}
            },
            "Get_subject_manager": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', body('Get_subject_user')?['id'], '/manager')}",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                },
                "queries": {
                  "$select": "mail,userPrincipalName"
                }
              },
              "runAfter": {
                "Get_subject_memberOf": [
                  "Succeeded"
                ]
              }
            },
            "Get_subject_licenses": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', body('Get_subject_user')?['id'], '/licenseDetails')}",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                },
                "queries": {
                  "$select": "skuPartNumber"
                }
              },
              "runAfter": {
                "Get_subject_manager": [
                  "Succeeded",
                  "Failed"
                ]
              }
            },
            "Compose_manager_email": {
              "type": "Compose",
              "runAfter": {
                "Get_subject_licenses": [
                  "Succeeded"
                ]
              },
              "inputs": "@if(equals(outputs('Get_subject_manager')?['statusCode'],200),coalesce(body('Get_subject_manager')?['mail'],body('Get_subject_manager')?['userPrincipalName'],''),'')"
            },
            "Filter_roles": {
              "type": "Query",
              "runAfter": {
                "Compose_manager_email": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Get_subject_memberOf')?['value']",
                "where": "@equals(item()?['@odata.type'],'#microsoft.graph.directoryRole')"
              }
            },
            "Filter_groups": {
              "type": "Query",
              "runAfter": {
                "Filter_roles": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Get_subject_memberOf')?['value']",
                "where": "@equals(item()?['@odata.type'],'#microsoft.graph.group')"
              }
            },
            "Select_group_names": {
              "type": "Select",
              "runAfter": {
                "Filter_groups": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Filter_groups')",
                "select": "@item()?['displayName']"
              }
            },
            "Select_role_names": {
              "type": "Select",
              "runAfter": {
                "Select_group_names": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Filter_roles')",
                "select": "@item()?['displayName']"
              }
            },
            "Select_license_names": {
              "type": "Select",
              "runAfter": {
                "Select_role_names": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Get_subject_licenses')?['value']",
                "select": "@item()?['skuPartNumber']"
              }
            },
            "Compose_llm_input": {
              "type": "Compose",
              "runAfter": {
                "Select_license_names": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "ticket_number": "@items('For_each_ticket')?['RowKey']",
                "ticket_type": "@items('For_each_ticket')?['ticketType']",
                "short_description": "@items('For_each_ticket')?['shortDescription']",
                "description": "@items('For_each_ticket')?['description']",
                "requester": {
                  "username": "@items('For_each_ticket')?['openedByUserName']",
                  "email": "@items('For_each_ticket')?['openedByEmail']"
                },
                "subject": {
                  "username": "@items('For_each_ticket')?['subjectUserName']",
                  "email": "@items('For_each_ticket')?['subjectEmail']",
                  "display_name": "@body('Get_subject_user')?['displayName']"
                },
                "subject_groups": "@body('Select_group_names')",
                "subject_licenses": "@body('Select_license_names')",
                "allowed_groups": "@parameters('allowedGroups')"
              }
            },
            "Call_llm": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{concat(parameters('aoaiEndpoint'), '/openai/deployments/', parameters('aoaiDeployment'), '/chat/completions')}",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://cognitiveservices.azure.com"
                },
                "queries": {
                  "api-version": "@parameters('aoaiApiVersion')"
                },
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "temperature": 0,
                  "max_tokens": 800,
                  "response_format": {
                    "type": "json_schema",
                    "json_schema": {
                      "name": "itsm_proposal",
                      "strict": true,
                      "schema": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "action",
                          "target_name",
                          "target_is_requester",
                          "secret_to_third_party",
                          "group_name",
                          "license_sku_hint",
                          "offboarding_steps",
                          "confidence",
                          "rationale_fr"
                        ],
                        "properties": {
                          "action": {
                            "type": "string",
                            "enum": [
                              "mfa_reset",
                              "password_reset",
                              "group_add",
                              "license_assign",
                              "offboarding",
                              "escalate"
                            ]
                          },
                          "target_name": {
                            "type": "string"
                          },
                          "target_is_requester": {
                            "type": "boolean"
                          },
                          "secret_to_third_party": {
                            "type": "boolean"
                          },
                          "group_name": {
                            "type": "string"
                          },
                          "license_sku_hint": {
                            "type": "string"
                          },
                          "offboarding_steps": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "disable_account",
                                "revoke_sessions",
                                "remove_groups",
                                "remove_licenses"
                              ]
                            }
                          },
                          "confidence": {
                            "type": "number"
                          },
                          "rationale_fr": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "messages": [
                    {
                      "role": "system",
                      "content": "You are the triage component of an IT service desk automation module.\nYou read ONE ticket (usually written in French) plus directory facts, and choose exactly ONE action from a closed list.\nYou never execute anything: a deterministic guard layer and then a human agent review your output.\n\nActions:\n- mfa_reset: the account owner lost access to their MFA method (new/lost phone, Authenticator gone).\n- password_reset: the account owner forgot their password or is locked out.\n- group_add: an access request that maps to exactly one entry of allowed_groups.\n- license_assign: a request for a software licence.\n- offboarding: an employee is leaving and their access must be removed.\n- escalate: anything else, ambiguous tickets, or several unrelated requests.\n\nFields:\n- target_name: full name of the person whose account the action applies to, as written in the ticket; if the ticket is about the requester themself, use subject.display_name.\n- target_is_requester: true ONLY if the account to act on belongs to the person who wrote the ticket (requester). A request made on behalf of someone else is false.\n- secret_to_third_party: true if the ticket asks that a password, code or credential be sent to anyone other than the account owner.\n- group_name: for group_add, the exact name from allowed_groups; otherwise \"\".\n- license_sku_hint: for license_assign, the product keyword in upper case (e.g. VISIO, PROJECT); otherwise \"\".\n- offboarding_steps: for offboarding, the steps the ticket asks for, from the allowed values; otherwise [].\n- confidence: 0 to 1.\n- rationale_fr: one or two sentences in French for the human agent explaining the choice. Never include any secret.\n\nReport facts faithfully. Do not decide whether the action is allowed: the guard layer does that from your fields."
                    },
                    {
                      "role": "user",
                      "content": "@{string(outputs('Compose_llm_input'))}"
                    }
                  ]
                }
              },
              "runAfter": {
                "Compose_llm_input": [
                  "Succeeded"
                ]
              }
            },
            "Compose_proposal": {
              "type": "Compose",
              "runAfter": {
                "Call_llm": [
                  "Succeeded"
                ]
              },
              "inputs": "@json(body('Call_llm')?['choices'][0]?['message']?['content'])"
            },
            "Filter_free_skus": {
              "type": "Query",
              "runAfter": {
                "Compose_proposal": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Get_subscribed_skus')?['value']",
                "where": "@and(contains(toUpper(item()?['skuPartNumber']),if(empty(outputs('Compose_proposal')?['license_sku_hint']),'#NONE#',toUpper(outputs('Compose_proposal')?['license_sku_hint']))),greater(item()?['prepaidUnits']?['enabled'],item()?['consumedUnits']))"
              }
            },
            "Compose_reasons": {
              "type": "Compose",
              "runAfter": {
                "Filter_free_skus": [
                  "Succeeded"
                ]
              },
              "inputs": "@union(if(and(or(equals(outputs('Compose_proposal')?['action'],'password_reset'),equals(outputs('Compose_proposal')?['action'],'mfa_reset')),greater(length(body('Filter_roles')),0)),createArray('target_privileged_role'),json('[]')),if(and(or(equals(outputs('Compose_proposal')?['action'],'password_reset'),equals(outputs('Compose_proposal')?['action'],'mfa_reset')),equals(outputs('Compose_proposal')?['target_is_requester'],false)),createArray('target_is_not_requester'),json('[]')),if(equals(outputs('Compose_proposal')?['secret_to_third_party'],true),createArray('secret_requested_for_third_party'),json('[]')),if(and(equals(outputs('Compose_proposal')?['action'],'offboarding'),not(equals(toLower(coalesce(items('For_each_ticket')?['openedByEmail'],'')),toLower(outputs('Compose_manager_email'))))),createArray('requester_not_manager'),json('[]')),if(and(equals(outputs('Compose_proposal')?['action'],'group_add'),not(contains(parameters('allowedGroupNames'),outputs('Compose_proposal')?['group_name']))),createArray('group_not_allowlisted'),json('[]')),if(and(equals(outputs('Compose_proposal')?['action'],'group_add'),contains(body('Select_group_names'),outputs('Compose_proposal')?['group_name'])),createArray('already_member'),json('[]')),if(and(equals(outputs('Compose_proposal')?['action'],'license_assign'),equals(length(body('Filter_free_skus')),0)),createArray('no_free_license_seat'),json('[]')),if(equals(outputs('Compose_proposal')?['action'],'escalate'),createArray('llm_escalated'),json('[]')),if(less(outputs('Compose_proposal')?['confidence'],0.6),createArray('low_confidence'),json('[]')))"
            },
            "Compose_status": {
              "type": "Compose",
              "runAfter": {
                "Compose_reasons": [
                  "Succeeded"
                ]
              },
              "inputs": "@if(greater(length(intersection(outputs('Compose_reasons'),createArray('target_privileged_role','target_is_not_requester','secret_requested_for_third_party','requester_not_manager','group_not_allowlisted'))),0),'refused',if(greater(length(outputs('Compose_reasons')),0),'needs_human','pending_review'))"
            },
            "Merge_proposal": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{concat('https://', parameters('storageAccountName'), '.table.core.windows.net/', parameters('tableName'), '(PartitionKey=''', parameters('clientCode'), ''',RowKey=''', items('For_each_ticket')?['RowKey'], ''')')}",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://storage.azure.com"
                },
                "headers": {
                  "x-ms-version": "2020-12-06",
                  "Accept": "application/json;odata=nometadata",
                  "X-HTTP-Method": "MERGE",
                  "Content-Type": "application/json"
                },
                "body": {
                  "proposalStatus": "@{outputs('Compose_status')}",
                  "proposalAction": "@{outputs('Compose_proposal')?['action']}",
                  "proposalJson": "@{string(outputs('Compose_proposal'))}",
                  "proposalRationale": "@{outputs('Compose_proposal')?['rationale_fr']}",
                  "proposalConfidence": "@{outputs('Compose_proposal')?['confidence']}",
                  "guardReasons": "@{join(outputs('Compose_reasons'), ',')}",
                  "subjectEntraId": "@{body('Get_subject_user')?['id']}",
                  "subjectPrivilegedRoles": "@{join(body('Select_role_names'), ',')}",
                  "subjectGroups": "@{join(body('Select_group_names'), ',')}",
                  "managerEmail": "@{outputs('Compose_manager_email')}",
                  "proposalModel": "@{parameters('aoaiDeployment')}",
                  "proposedAtUtc": "@{utcNow()}"
                }
              },
              "runAfter": {
                "Compose_status": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Merge_not_found": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "@{concat('https://', parameters('storageAccountName'), '.table.core.windows.net/', parameters('tableName'), '(PartitionKey=''', parameters('clientCode'), ''',RowKey=''', items('For_each_ticket')?['RowKey'], ''')')}",
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://storage.azure.com"
                  },
                  "headers": {
                    "x-ms-version": "2020-12-06",
                    "Accept": "application/json;odata=nometadata",
                    "X-HTTP-Method": "MERGE",
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "proposalStatus": "needs_human",
                    "guardReasons": "subject_not_found_in_entra",
                    "proposalRationale": "Utilisateur concerne introuvable dans Entra ID : traitement manuel requis.",
                    "proposedAtUtc": "@{utcNow()}"
                  }
                },
                "runAfter": {}
              }
            }
          }
        }
      }
    }
  },
  "outputs": {}
}