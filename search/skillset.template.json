{
  "name": "ss-__CLIENTID__-text",
  "description": "Pipeline TEXTE NATIF (formats sans mise en page complexe : .md, .txt, .csv, .json, etc. - tout ce qui n'est pas traite par le pipeline Document Intelligence). Chunking + vectorisation via text-embedding-3-large (managed identity). Injecte clientId (defense in depth).",
  "skills": [
    {
      "@odata.type": "#Microsoft.Skills.Text.SplitSkill",
      "name": "split",
      "description": "Splits the content into pages/chunks",
      "context": "/document",
      "textSplitMode": "pages",
      "maximumPageLength": 2000,
      "pageOverlapLength": 500,
      "inputs": [
        { "name": "text", "source": "/document/content" }
      ],
      "outputs": [
        { "name": "textItems", "targetName": "pages" }
      ]
    },
    {
      "@odata.type": "#Microsoft.Skills.Text.AzureOpenAIEmbeddingSkill",
      "name": "embed",
      "description": "Vectorizes each chunk",
      "context": "/document/pages/*",
      "resourceUri": "https://aif-knowledgeengine2-v9.openai.azure.com",
      "deploymentId": "text-embedding-3-large",
      "modelName": "text-embedding-3-large",
      "dimensions": 3072,
      "inputs": [
        { "name": "text", "source": "/document/pages/*" }
      ],
      "outputs": [
        { "name": "embedding", "targetName": "text_vector" }
      ]
    }
  ],
  "indexProjections": {
    "selectors": [
      {
        "targetIndexName": "idx-__CLIENTID__",
        "parentKeyFieldName": "parent_id",
        "sourceContext": "/document/pages/*",
        "mappings": [
          { "name": "chunk", "source": "/document/pages/*" },
          { "name": "text_vector", "source": "/document/pages/*/text_vector" },
          { "name": "title", "source": "/document/metadata_storage_name" },
          { "name": "clientId", "source": "/document/clientid" }
        ]
      }
    ],
    "parameters": {
      "projectionMode": "skipIndexingParentDocuments"
    }
  }
}
