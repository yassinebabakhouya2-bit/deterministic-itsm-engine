{
  "name": "ss-__CLIENTID__-di",
  "description": "Pipeline DOCUMENT INTELLIGENCE (formats a mise en page complexe : .pdf, .docx, .xlsx, .pptx, .html, images). Extraction universelle du texte ET des tableaux + chunking integre + vectorisation via text-embedding-3-large (managed identity). Injecte clientId (defense in depth).",
  "skills": [
    {
      "@odata.type": "#Microsoft.Skills.Util.DocumentIntelligenceLayoutSkill",
      "name": "layout",
      "description": "Extrait le contenu structure (texte + tableaux) depuis PDF/Office/images. Chunking integre.",
      "context": "/document",
      "outputMode": "oneToMany",
      "outputFormat": "text",
      "chunkingProperties": {
        "unit": "characters",
        "maximumLength": 2000,
        "overlapLength": 500
      },
      "inputs": [
        { "name": "file_data", "source": "/document/file_data" }
      ],
      "outputs": [
        { "name": "text_sections", "targetName": "text_sections" }
      ]
    },
    {
      "@odata.type": "#Microsoft.Skills.Text.AzureOpenAIEmbeddingSkill",
      "name": "embed",
      "description": "Vectorise chaque chunk",
      "context": "/document/text_sections/*",
      "resourceUri": "https://aif-knowledgeengine2-v9.openai.azure.com",
      "deploymentId": "text-embedding-3-large",
      "modelName": "text-embedding-3-large",
      "dimensions": 3072,
      "inputs": [
        { "name": "text", "source": "/document/text_sections/*/content" }
      ],
      "outputs": [
        { "name": "embedding", "targetName": "text_vector" }
      ]
    }
  ],
  "cognitiveServices": {
    "@odata.type": "#Microsoft.Azure.Search.AIServicesByIdentity",
    "description": "Identite managee systeme du service Search, role 'Cognitive Services User' sur la ressource Foundry.",
    "subdomainUrl": "https://aif-knowledgeengine2-v9.services.ai.azure.com",
    "identity": null
  },
  "indexProjections": {
    "selectors": [
      {
        "targetIndexName": "idx-__CLIENTID__",
        "parentKeyFieldName": "parent_id",
        "sourceContext": "/document/text_sections/*",
        "mappings": [
          { "name": "chunk", "source": "/document/text_sections/*/content" },
          { "name": "text_vector", "source": "/document/text_sections/*/text_vector" },
          { "name": "title", "source": "/document/metadata_storage_name" },
          { "name": "clientId", "source": "/document/clientid" }
        ]
      }
    ],
    "parameters": {
      "projectionMode": "skipIndexingParentDocuments"
    }
  }
}
